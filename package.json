{
  "name": "cf-invoice-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "Chat agent that explains a Cloudflare bill from account usage data",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "types": "wrangler types env.d.ts --strict-vars false",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ test/ scripts/ evals/",
    "check": "oxfmt --check . && oxlint src/ test/ scripts/ evals/ && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "COVERAGE_SCOPE=domain vitest run --project unit --coverage && COVERAGE_SCOPE=app vitest run --project integration --coverage",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "smoke": "node scripts/smoke.mjs",
    "gate": "node scripts/check-phase-gate.mjs",
    "eval": "node scripts/eval.mjs",
    "record": "node scripts/record.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@cloudflare/ai-chat": "^0.12.1",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.26.0",
    "ai": "^7.0.127",
    "jose": "^6.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.35.5"
  }
}
